{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(**/*credential*)",
      "Read(**/*secret*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Bash(cat *.env*)",
      "Bash(cat *credential*)",
      "Bash(cat *secret*)",
      "Bash(type *.env*)",
      "Bash(Get-Content *.env*)"
    ]
  }
}
